{
  "expo": {
    "name": "Savr",
    "slug": "savr",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "savr",
    "description": "Track expenses, set budgets, get insights. Smart, fast, beautiful.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saver.savr"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "navigationBarColor": "#0F0F0F",
      "package": "com.saver.savr",
      "backgroundColor": "#0F0F0F",
      "versionCode": 25,
      "targetSdkVersion": 35,
      "googleMobileAdsAppId": "ca-app-pub-6010190127310138~6262367655",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
  "expo-navigation-bar",
  {
    "position": "absolute",
    "visibility": "visible",
    "backgroundColor": "#0F0F0F"
  }
],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6010190127310138~6262367655"
        }
      ],
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0F",
          "image": "./assets/icon.png",
          "imageWidth": 80,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06661bbd-b3e6-4e14-8480-9d3cd0ecda34"
      }
    },
    "owner": "mwnswrang"
  }
}
